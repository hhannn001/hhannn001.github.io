---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
<url><loc>{{ '/' | absolute_url }}</loc></url>
{% for post in site.posts %}<url><loc>{{ post.url | absolute_url | xml_escape }}</loc><lastmod>{{ post.date | date_to_xmlschema }}</lastmod></url>{% endfor %}
{% for item in site.pages %}{% if item.category_board or item.url == '/about/' %}<url><loc>{{ item.url | absolute_url | xml_escape }}</loc></url>{% endif %}{% endfor %}
</urlset>
